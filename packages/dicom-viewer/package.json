{
  "name": "@mihawksolutions/dicom-viewer",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "React DICOM viewer building blocks for locally selected files: a 2D and 3D (CBCT) viewer component, file scanning, presets and a DICOM tag reader, built on Cornerstone3D.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite/index.d.ts",
      "import": "./dist/vite.js"
    },
    "./internal": {
      "types": "./dist/types/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./internal/cornerstone": {
      "types": "./dist/types/internalCornerstone.d.ts",
      "import": "./dist/internal-cornerstone.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "@cornerstonejs/core": "5.19.4",
    "@cornerstonejs/dicom-image-loader": "5.19.4",
    "@cornerstonejs/metadata": "5.19.4",
    "@cornerstonejs/tools": "5.19.4",
    "@cornerstonejs/utils": "5.19.4",
    "dicom-parser": "1.8.21",
    "events": "3.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "keywords": [
    "dicom",
    "react",
    "cornerstone3d",
    "cbct",
    "medical-imaging"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
